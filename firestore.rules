rules_version = '2';

// Panel de Combustibles · UNO Guaimaca Centro.
// Acceso solo para usuarios autenticados con ficha activa en users/{email}; los permisos salen de
// roles/{roleId}.permissions. El super admin (mismo correo fijado en AuthContext) puede crear la
// configuración inicial cuando el sistema está vacío.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email; }
    function isSuperAdmin() {
      return signedIn() && email() == 'melchisedec.bustamante@gmail.com' && request.auth.token.email_verified == true;
    }
    function ficha() { return get(/databases/$(database)/documents/users/$(email())).data; }
    // Correo verificado obligatorio: sin esto, cualquiera podría registrarse con contraseña usando el correo
    // de una ficha que aún no inició sesión y heredar su rol.
    function verificado() { return signedIn() && request.auth.token.email_verified == true; }
    function tieneFicha() { return verificado() && exists(/databases/$(database)/documents/users/$(email())); }
    function activo() { return isSuperAdmin() || (tieneFicha() && ficha().status == 'activo'); }
    function permiso(p) {
      return isSuperAdmin() || (
        activo()
        && exists(/databases/$(database)/documents/roles/$(ficha().roleId))
        && get(/databases/$(database)/documents/roles/$(ficha().roleId)).data.permissions[p] == true
      );
    }

    // Fichas de usuario: cada quien lee la suya (para validar el acceso al iniciar sesión).
    match /users/{userEmail} {
      allow read: if signedIn() && (email() == userEmail || permiso('canManageUsers'));
      allow create, update: if permiso('canManageUsers');
      allow delete: if false;
    }

    match /roles/{roleId} {
      allow read: if activo();
      allow write: if permiso('canManageUsers');
    }

    match /pumps/{pumpId} {
      allow read: if activo();
      allow write: if permiso('canManagePumps');
    }

    // Historial de precios: solo se agregan entradas.
    function precioValido(p) { return p is number && p > 0 && p <= 200; }
    match /prices/{priceId} {
      allow read: if activo();
      // Precio por litro razonable y vigencia ISO (se compara como texto para resolver el vigente).
      allow create: if permiso('canEditPrices')
        && precioValido(request.resource.data.super)
        && precioValido(request.resource.data.regular)
        && precioValido(request.resource.data.diesel)
        && (!('vigenteDesde' in request.resource.data)
            || request.resource.data.vigenteDesde.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{3})?Z$'));
      allow update, delete: if false;
    }

    // Sugerencias del precio oficial semanal: las escribe la Cloud Function (Admin SDK).
    match /prices_official/{id} {
      allow read: if activo();
      allow write: if false;
    }
    match /prices_official_errors/{id} {
      allow read: if permiso('canEditPrices');
      allow write: if false;
    }

    // settings/operacion (turnos, TASK-019) también lo edita quien configura bombas.
    match /settings/{settingId} {
      allow read: if activo();
      allow write: if permiso('canEditPrices') || (settingId == 'operacion' && permiso('canManagePumps'));
    }

    function diaCerrado(fecha) {
      return exists(/databases/$(database)/documents/dayStatus/$(fecha))
        && get(/databases/$(database)/documents/dayStatus/$(fecha)).data.get('status', '') == 'cerrado';
    }
    // `tramos` (venta por turno) decide la venta: solo lo escribe quien puede cerrar el día (cierre de turno).
    function tramosPermitidos(previos) {
      return (request.resource.data.get('tramos', null) == previos || permiso('canCloseDay'))
        && (!('tramos' in request.resource.data) || request.resource.data.tramos is list);
    }
    function lecturaValida() {
      return request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.initialReading is number
        && (!('finalReading' in request.resource.data) || request.resource.data.finalReading is number);
    }

    // Con la final guardada, nada que cambie la venta se toca sin canCloseDay (corrección con motivo).
    function finalIntacta() {
      return request.resource.data.get('finalReading', null) == resource.data.finalReading
        && request.resource.data.get('rollover', false) == resource.data.get('rollover', false)
        && request.resource.data.get('status', null) == resource.data.get('status', null)
        && request.resource.data.get('fuelPrice', null) == resource.data.get('fuelPrice', null)
        && request.resource.data.get('meterMax', null) == resource.data.get('meterMax', null)
        && request.resource.data.get('fuelId', null) == resource.data.get('fuelId', null)
        && request.resource.data.get('dispenserId', null) == resource.data.get('dispenserId', null)
        && request.resource.data.get('tramos', null) == resource.data.get('tramos', null);
    }

    // Lecturas de totalizadores: cualquier usuario activo registra mientras el día esté abierto;
    // con el día cerrado solo corrige quien puede cerrar el día. No se borran.
    match /readings/{readingId} {
      allow read: if activo();
      allow create: if activo() && lecturaValida() && tramosPermitidos(null)
        && (!diaCerrado(request.resource.data.date) || permiso('canCloseDay'));
      // Cambiar la lectura inicial ya registrada es una corrección: exige canCloseDay.
      // Igual cambiar (o borrar) una final ya guardada, o su vuelta a cero: es corrección con motivo.
      allow update: if activo() && lecturaValida() && tramosPermitidos(resource.data.get('tramos', null))
        && request.resource.data.date == resource.data.date
        && (request.resource.data.initialReading == resource.data.initialReading || permiso('canCloseDay'))
        && (!('finalReading' in resource.data) || finalIntacta() || permiso('canCloseDay'))
        && (!diaCerrado(resource.data.date) || permiso('canCloseDay'));
      allow delete: if false;
    }

    // Día operativo (tanques, pipas, fondo, horómetro, estado).
    // Cambiar el estado (cerrar, reabrir o borrar el campo) exige canCloseDay; con el día cerrado,
    // cualquier cambio exige canCloseDay.
    match /dayStatus/{date} {
      allow read: if activo();
      // El id del día es la fecha (YYYY-MM-DD); evita días "fantasma" fuera de los reportes.
      allow create: if activo() && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && (
        request.resource.data.get('status', 'en_proceso') in ['en_proceso', 'pendiente']
        || permiso('canCloseDay')
      );
      allow update: if activo() && (
        permiso('canCloseDay')
        || (request.resource.data.get('status', null) == resource.data.get('status', null)
            && resource.data.get('status', '') != 'cerrado')
      );
      allow delete: if false;
    }

    // ─── Turnos y arqueo por bombero (TASK-019; la app solo los usa con settings/operacion.shiftsEnabled) ───
    function fechaIso(f) { return f is string && f.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function turno(id) { return get(/databases/$(database)/documents/shifts/$(id)).data; }
    function numOpcional(d, k) { return !(k in d) || d[k] is number; }
    function rutaEstado() { return /databases/$(database)/documents/shiftState/actual; }
    function rutaTurno(id) { return /databases/$(database)/documents/shifts/$(id); }
    // Turno abierto según el puntero antes de la escritura (null si no hay puntero).
    function abiertoAntes() { return exists(rutaEstado()) ? get(rutaEstado()).data.get('openShiftId', null) : null; }
    function abiertoDespues() { return getAfter(rutaEstado()).data.get('openShiftId', null); }

    // Puntero al turno abierto y al último cerrado (garantiza un solo turno abierto a la vez).
    // Solo pasa de null → id (al abrir ese turno, creado en la misma transacción) o de id → null
    // (al cerrar ese turno en la misma transacción; lastShiftId queda en ese id).
    function abrePuntero(antes) {
      return antes == null
        && request.resource.data.openShiftId is string
        && !exists(rutaTurno(request.resource.data.openShiftId))
        && existsAfter(rutaTurno(request.resource.data.openShiftId))
        && getAfter(rutaTurno(request.resource.data.openShiftId)).data.status == 'abierto';
    }
    function cierraPuntero(antes) {
      return antes is string
        && request.resource.data.get('openShiftId', '') == null
        && request.resource.data.get('lastShiftId', null) == antes
        && getAfter(rutaTurno(antes)).data.status == 'cerrado';
    }
    match /shiftState/{docId} {
      allow read: if activo();
      allow create: if docId == 'actual' && permiso('canCloseDay') && abrePuntero(null);
      allow update: if docId == 'actual' && permiso('canCloseDay')
        && (abrePuntero(resource.data.get('openShiftId', null)) || cierraPuntero(resource.data.get('openShiftId', null)));
      allow delete: if false;
    }

    // Turno: lo abre y lo cierra quien puede cerrar el día. Cerrado no se modifica. No se borra.
    match /shifts/{shiftId} {
      allow read: if activo();
      allow create: if permiso('canCloseDay')
        && fechaIso(request.resource.data.date)
        && request.resource.data.templateId is string
        && shiftId == request.resource.data.date + '_' + request.resource.data.templateId
        && request.resource.data.status == 'abierto'
        && request.resource.data.assignments is list
        && request.resource.data.attendantEmails is list
        && request.resource.data.dispenserIds is list
        // Día cerrado: hay que reabrirlo (con motivo) antes de abrir un turno en él.
        && !diaCerrado(request.resource.data.date)
        // Un solo turno abierto: el puntero estaba libre y queda apuntando a este turno.
        && abiertoAntes() == null
        && abiertoDespues() == shiftId;
      allow update: if permiso('canCloseDay')
        && resource.data.status == 'abierto'
        && request.resource.data.status in ['abierto', 'cerrado']
        && request.resource.data.date == resource.data.date
        && request.resource.data.templateId == resource.data.templateId
        && request.resource.data.attendantEmails is list
        && request.resource.data.get('dispenserIds', null) == resource.data.get('dispenserIds', null)
        && !diaCerrado(resource.data.date)
        // Cerrar el turno libera el puntero en la misma transacción.
        && (request.resource.data.status == 'abierto'
            || (abiertoDespues() == null && getAfter(rutaEstado()).data.get('lastShiftId', null) == shiftId));
      allow delete: if false;
    }

    // Lecturas por turno: solo mientras el turno está abierto; la inicial y la manguera no cambian.
    match /shiftReadings/{readingId} {
      allow read: if activo();
      allow create: if permiso('canCloseDay')
        && readingId == request.resource.data.shiftId + '_' + request.resource.data.dispenserId
        && request.resource.data.initialReading is number
        && numOpcional(request.resource.data, 'finalReading')
        && existsAfter(rutaTurno(request.resource.data.shiftId))
        && getAfter(rutaTurno(request.resource.data.shiftId)).data.status == 'abierto'
        && request.resource.data.date == getAfter(rutaTurno(request.resource.data.shiftId)).data.date
        && request.resource.data.dispenserId in getAfter(rutaTurno(request.resource.data.shiftId)).data.dispenserIds
        && !diaCerrado(request.resource.data.date);
      allow update: if permiso('canCloseDay')
        && request.resource.data.shiftId == resource.data.shiftId
        && request.resource.data.dispenserId == resource.data.dispenserId
        && request.resource.data.date == resource.data.date
        && request.resource.data.initialReading == resource.data.initialReading
        && numOpcional(request.resource.data, 'finalReading')
        && turno(resource.data.shiftId).status == 'abierto'
        && !diaCerrado(resource.data.date);
      allow delete: if false;
    }

    // Arqueo por bombero: lo registra quien puede cerrar el día, o el propio bombero asignado al turno
    // (sin marcarlo recibido y solo mientras nadie lo recibió). No se borra.
    function arqueoValido(cashId) {
      return cashId == request.resource.data.shiftId + '_' + request.resource.data.email
        && request.resource.data.cash is number && request.resource.data.card is number
        && request.resource.data.credits is number && request.resource.data.partialDrops is number
        && request.resource.data.cash >= 0 && request.resource.data.card >= 0
        && request.resource.data.credits >= 0 && request.resource.data.partialDrops >= 0
        && exists(/databases/$(database)/documents/shifts/$(request.resource.data.shiftId))
        && request.resource.data.email in turno(request.resource.data.shiftId).attendantEmails
        && request.resource.data.date == turno(request.resource.data.shiftId).date
        // Con el día cerrado el arqueo no se toca (ni el recibido): hay que reabrir el día.
        && !diaCerrado(request.resource.data.date);
    }
    function arqueoPropio() {
      return email().lower() == request.resource.data.email && !('receivedBy' in request.resource.data);
    }
    match /cashCounts/{cashId} {
      allow read: if activo();
      allow create: if activo() && arqueoValido(cashId) && (permiso('canCloseDay') || arqueoPropio());
      allow update: if activo() && arqueoValido(cashId)
        && request.resource.data.shiftId == resource.data.shiftId
        && request.resource.data.email == resource.data.email
        && (permiso('canCloseDay') || (arqueoPropio() && !('receivedBy' in resource.data)));
      allow delete: if false;
    }

    // Auditoría: se agrega, nunca se edita ni se borra.
    match /auditLog/{entryId} {
      allow read: if permiso('canViewAudit');
      // Quien registra es quien inicia sesión (no se puede firmar a nombre de otro uid).
      allow create: if activo() && request.resource.data.userId == request.auth.uid
        && (isSuperAdmin() || request.resource.data.get('userName', '') == ficha().name);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
