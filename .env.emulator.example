# Copiar a .env.local para desarrollar contra los emuladores locales.
# Arranque: `npm run emulators` (otra terminal) → `npm run seed:emu` → `npm run dev`.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=uno-panel.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=uno-panel
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=uno-panel.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:emulator
